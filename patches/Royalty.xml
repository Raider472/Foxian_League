<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--Empire not hostile to foxian league and foxian player colony-->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/FactionDef[defName="Empire"]/permanentEnemyToEveryoneExcept</xpath>
            <value>
                <li>Foxian_League</li>
                <li>FoxianPlayerColony</li>
            </value>
        </match>
    </Operation>

    <!--Add the Natura seeds to some traders inventory-->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/TraderKindDef[defName="Orbital_Exotic"]/stockGenerators</xpath>
            <value>
                <li MayRequire="Ludeon.RimWorld.Royalty" Class="StockGenerator_SingleDef">
                    <thingDef>FL_NaturaSeed</thingDef>
                    <countRange>0~1</countRange>
                </li>
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/TraderKindDef[defName="Caravan_Neolithic_ShamanMerchant"]/stockGenerators</xpath>
            <value>
                <li MayRequire="Ludeon.RimWorld.Royalty" Class="StockGenerator_SingleDef">
                    <thingDef>FL_NaturaSeed</thingDef>
                    <countRange>0~1</countRange>
                </li>
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
            <value>
                <li MayRequire="Ludeon.RimWorld.Royalty" Class="StockGenerator_SingleDef">
                    <thingDef>FL_NaturaSeed</thingDef>
                    <countRange>0~1</countRange>
                </li>
            </value>
        </match>
    </Operation>
</Patch>