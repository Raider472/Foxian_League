<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="FoxianRaiderClothing">
        <defName>FL_BloodRainDeel</defName>
        <label>blood deel</label>
        <description>A traditional Blood Rain outfit reinforced with steel plates. It is used to convey the wearer's importance within the organization. Although the outfit is not as protective as conventional armor, it is light enough that the wearer can move without hindrance, and it is embedded with Blood Rain runes to physically enhance the wearer. It is rumored that the empress gave these outfits to those she trusts the most to carry out her more deranged orders.</description>
        <techLevel>Industrial</techLevel>
        <graphicData>
            <texPath>Things/Pawns/Apparels/OfficerArmor/OfficerArmor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <recipeMaker>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
        </recipeMaker>
        <costList>
            <Cloth>90</Cloth>
            <Gold>25</Gold>
            <Steel>35</Steel>
        </costList>
        <generateCommonality>2</generateCommonality>
        <statBases>
            <WorkToMake>17500</WorkToMake>
            <MaxHitPoints>280</MaxHitPoints>
            <Mass>2</Mass>
            <Flammability>0.8</Flammability>
            <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.18</ArmorRating_Blunt>
            <ArmorRating_Heat>0.5</ArmorRating_Heat>
            <Insulation_Cold>16</Insulation_Cold>
            <Insulation_Heat>8</Insulation_Heat>
            <EquipDelay>2.5</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
            <SuppressionPower MayRequire="Ludeon.RimWorld.Ideology">0.25</SuppressionPower>
            <MoveSpeed>0.2</MoveSpeed>
            <MeleeDamageFactor>0.15</MeleeDamageFactor>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawns/Apparels/OfficerArmor/OfficerArmor</wornGraphicPath>
            <useWornGraphicMask>true</useWornGraphicMask>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
        <thingSetMakerTags>
            <li>RewardStandardMidFreq</li>
        </thingSetMakerTags>
    </ThingDef>

    <ThingDef ParentName="FoxianArmor">
        <defName>FL_SkullArmor</defName>
