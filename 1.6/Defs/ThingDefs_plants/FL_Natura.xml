<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="TreeBase" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>FL_Plant_TreeNatura</defName>
        <label>Natura tree</label>
        <description>An unknown tree that is exclusively found on this rimworld, it's typically seen inside settlements belonging to the Foxian League. Nevertheless, some outlanders have claimed to have witnessed some of these trees outside the sphere of influence of the Foxian League. Foxians and naturalist psycasters believe that they can receive blessings when meditating next to it. They only grow from seeds extracted from Natura flowers or planted by a psycaster with the hidden coveted knowledge.</description>
        <graphicData>
            <texPath>Things/Plants/Natura</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <shadowData>
            <volume>(0.35, 0.3, 0.35)</volume>
            <offset>(0,0,0.05)</offset>
            </shadowData>
        </graphicData>
        <minifiedDef IsNull="True" />
        <statBases>
            <Beauty>6</Beauty>
            <BeautyOutdoors>6</BeautyOutdoors>
            <Flammability>1</Flammability>
            <MaxHitPoints>300</MaxHitPoints>
        </statBases>
        <ingestible />
        <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
        <canScatterOver>false</canScatterOver>
        <plant>
            <growDays>15</growDays>
            <visualSizeRange>1.5~2.1</visualSizeRange>
            <sowMinSkill>0</sowMinSkill>
            <sowTags Inherit="False"/>
            <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
            <fertilityMin>0.8</fertilityMin>
            <fertilitySensitivity>0.35</fertilitySensitivity>
            <wildClusterWeight>0</wildClusterWeight>
            <sowWork>400</sowWork>
            <harvestYield>30</harvestYield>
            <treeCategory>Super</treeCategory>
            <dieIfNoSunlight>false</dieIfNoSunlight>
            <sowResearchPrerequisites Inherit="False" />
            <dieFromToxicFallout>False</dieFromToxicFallout>
            <minSpacingBetweenSamePlant>5</minSpacingBetweenSamePlant>
            <warnIfMarkedForCut>true</warnIfMarkedForCut>
            <harvestWork>1000</harvestWork>
            <choppedThingDef>FL_ChoppedStump_Natura</choppedThingDef>
            <smashedThingDef>FL_SmashedStump_Natura</smashedThingDef>
            <immatureGraphicPath>Things/Plants/Natura_Immature</immatureGraphicPath>
            <snowOverlayGraphicPath>Things/Plants/Natura_Snowy</snowOverlayGraphicPath>
            <immatureSnowOverlayGraphicPath>Things/Plants/Natura_ImmatureSnowy</immatureSnowOverlayGraphicPath>
        </plant>
        <comps>
            <li Class="CompProperties_SelfhealHitpoints">
                <ticksPerHeal>2000</ticksPerHeal> <!-- 30 hp per day, must be a multiple of 2000, since plants have Long ticker -->
            </li>
            <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                    <li>Natural</li>
                </focusTypes>
            </li>
            <li Class="Foxian_league.CompProperties_NaturaPsychic"/>
        </comps>
    </ThingDef>

    <ThingDef ParentName="StumpChoppedBase" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>FL_ChoppedStump_Natura</defName>
        <label>chopped Natura stump</label>
        <description>A stump left behind after a Natura tree has been felled. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Chopped/FL_NaturaChopped</texPath>
            <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    </ThingDef>

    <ThingDef ParentName="StumpSmashedBase" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>FL_SmashedStump_Natura</defName>
        <label>smashed Natura stump</label>
        <description>The remnants of a Natura tree destroyed by damage. It's ugly. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Smashed/FL_NaturaSmashed</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>

    <ThingDef ParentName="ResourceBase" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>FL_NaturaSeed</defName>
        <label>natura seed</label>
        <description>The seed of a natura tree. It can be planted to create a new natura tree.</description>
        <descriptionHyperlinks>
            <ThingDef>FL_Plant_TreeNatura</ThingDef>
        </descriptionHyperlinks>
        <stackLimit>5</stackLimit>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>0.3</Mass>
            <Beauty>0</Beauty>
            <MarketValue>800</MarketValue>
        </statBases>
        <graphicData>
            <texPath>Things/Items/FL_NaturaSeeds</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <drawSize>(0.6, 0.6)</drawSize>
        </graphicData>
        <thingCategories>
            <li>ItemsMisc</li>
        </thingCategories>
        <comps>
            <li Class="CompProperties_Plantable">
            <plantDefToSpawn>FL_Plant_TreeNatura</plantDefToSpawn>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="PlantBaseNonEdible" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>FL_Plant_PodNatura</defName>
        <label>Natura flower</label>
        <description>A small flower that protects a single Natura seed. This seed can be harvested and used to plant a Natura tree.</description>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
        </statBases>
        <graphicData>
            <texPath>Things/Plant/GauranlenPod</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <descriptionHyperlinks>
            <ThingDef>FL_Plant_TreeNatura</ThingDef>
            <ThingDef>FL_NaturaSeed</ThingDef>
        </descriptionHyperlinks>
        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <pathCost>14</pathCost>
        <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
        <plant>
            <fertilitySensitivity>0.15</fertilitySensitivity>
            <growDays>3</growDays>
            <harvestYield>1</harvestYield>
            <harvestTag>Standard</harvestTag>
            <harvestAfterGrowth>0</harvestAfterGrowth>
            <harvestedThingDef>FL_NaturaSeed</harvestedThingDef>
            <harvestFailable>false</harvestFailable>
            <harvestYieldAffectedByDifficulty>false</harvestYieldAffectedByDifficulty>
            <visualSizeRange>0.6~1.1</visualSizeRange>
            <topWindExposure>0.1</topWindExposure>
            <wildClusterWeight>0</wildClusterWeight>
            <purpose>Misc</purpose>
            <allowAutoCut>false</allowAutoCut>
            <dieFromToxicFallout>False</dieFromToxicFallout>
            <warnIfMarkedForCut>true</warnIfMarkedForCut>
        </plant>
    </ThingDef>
</Defs>