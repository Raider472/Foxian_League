<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="LeatherBase">
        <defName>FL_LeatherHulkarash</defName>
        <label>hulkarash leather</label>
        <description>Tanned, dried, scraped hulkaras skin. It's tough and an excellent insulator
            against the cold.</description>
        <graphicData>
            <color>(148,60,58)</color>
        </graphicData>
        <statBases>
            <MarketValue>3.0</MarketValue>
            <StuffPower_Armor_Sharp>1.25</StuffPower_Armor_Sharp>
            <StuffPower_Insulation_Cold>31</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>11</StuffPower_Insulation_Heat>
        </statBases>
        <stuffProps>
            <color>(148,60,58)</color>
            <commonality>0.025</commonality>
            <statFactors>
                <MaxHitPoints>1.5</MaxHitPoints>
                <Beauty>1.3</Beauty>
            </statFactors>
        </stuffProps>
    </ThingDef>

    <ThingDef ParentName="WoolBase">
        <defName>FL_WoolHulkarash</defName>
        <label>hulkarash wool</label>
        <description>While somewhat coarse, hulkarash wool's long fibers make it very strong. It is
            exceptionally warm.</description>
        <possessionCount>30</possessionCount>
        <statBases>
            <StuffPower_Armor_Sharp>0.94</StuffPower_Armor_Sharp>
            <StuffPower_Insulation_Cold>37</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>17</StuffPower_Insulation_Heat>
        </statBases>
        <graphicData>
            <color>(181,91,89)</color>
        </graphicData>
        <stuffProps>
            <color>(181,91,89)</color>
        </stuffProps>
    </ThingDef>

    <ThingDef ParentName="LeatherBase">
        <defName>FL_LeatherVulyakko</defName>
        <label>vulyakko fur</label>
        <description>A soft furry pelt harvested from a vulyakko. It is difficult to pierce and
            insulates well against heat.</description>
        <possessionCount>20</possessionCount>
        <graphicData>
            <color>(239,239,239)</color>
        </graphicData>
        <statBases>
            <MarketValue>3.0</MarketValue>
            <StuffPower_Armor_Sharp>0.98</StuffPower_Armor_Sharp>
            <StuffPower_Insulation_Heat>24</StuffPower_Insulation_Heat>
        </statBases>
        <stuffProps>
            <color>(239,239,239)</color>
            <commonality>0.075</commonality>
            <statFactors>
                <Beauty>1.8</Beauty>
