    <ThingDef ParentName="LeatherBase">
        <defName>FL_LeatherVulpano</defName>
        <label>vulpano fur</label>
        <description>The furry pelt of vulpano. Good at temperature regulation in cold climates.</description>
        <possessionCount>20</possessionCount>
        <graphicData>
            <color>(196,217,219)</color>
        </graphicData>
        <statBases>
            <MarketValue>2.4</MarketValue>
            <StuffPower_Insulation_Cold>26</StuffPower_Insulation_Cold>
