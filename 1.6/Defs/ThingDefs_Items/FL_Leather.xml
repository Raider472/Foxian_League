        <possessionCount>30</possessionCount>
        <statBases>
            <StuffPower_Insulation_Cold>32</StuffPower_Insulation_Cold>
            <StuffPower_Insulation_Heat>15</StuffPower_Insulation_Heat>
        </statBases>
        <graphicData>
            <color>(145,209,214)</color>
        </graphicData>
        <stuffProps>
            <color>(145,209,214)</color>
        </stuffProps>
