<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <HediffDef ParentName="PsychiChannelingAbs">
        <defName>FL_PsychichChanneling</defName>
        <label>Psychic channeling</label>
        <hediffClass>Foxian_league.HediffSeverityScalingStat</hediffClass>
        <minSeverity>0</minSeverity>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>0</initialSeverity>
        <stages>
            <li>
                <label>dormant</label>
            </li>
            <li>
                <!--All those values are the max when 100%-->
                <minSeverity>0.01</minSeverity>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
                <statOffsets>
                    <MeleeDamageFactor>0.5</MeleeDamageFactor>
                    <MeleeCooldownFactor>-0.25</MeleeCooldownFactor>
                    <MeleeHitChance>7.5</MeleeHitChance>
                </statOffsets>
            </li>
        </stages>
        <modExtensions>
            <li Class="Foxian_league.HediffExtension_ScalableSeverityStat">
                <scalingStat>PsychicSensitivity</scalingStat>
                <statLimit>1~2.5</statLimit>
            </li>
        </modExtensions>
    </HediffDef>
</Defs>