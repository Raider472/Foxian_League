<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>FL_Tree_Connection</defName>
        <label>natural connection</label>
        <description>This devotee has received the blessing of a Natura tree for its devotion. The blessings permanently increase the psychic sensitivity of the chosen individual. The bonus will get bigger as more blessings are earned.</description>
        <defaultLabelColor>(0.41, 0.91, 0.72)</defaultLabelColor>
        <everCurableByItem>false</everCurableByItem>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
        <stages>
            <li>
                <label>novice</label>
                <statOffsets>
                    <PsychicSensitivity>0.1</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.2</minSeverity>
                <label>acolyte</label>
                <statOffsets>
                    <PsychicSensitivity>0.2</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.3</minSeverity>
                <label>devotee</label>
                <statOffsets>
                    <PsychicSensitivity>0.3</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.4</minSeverity>
                <label>disciple</label>
                <statOffsets>
                    <PsychicSensitivity>0.4</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.5</minSeverity>
                <label>adept</label>
                <statOffsets>
                    <PsychicSensitivity>0.5</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.6</minSeverity>
                <label>venerated</label>
                <statOffsets>
                    <PsychicSensitivity>0.6</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.7</minSeverity>
                <label>enlighten</label>
                <statOffsets>
                    <PsychicSensitivity>0.7</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.8</minSeverity>
                <label>exalted</label>
                <statOffsets>
                    <PsychicSensitivity>0.8</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.9</minSeverity>
                <label>revered</label>
                <statOffsets>
                    <PsychicSensitivity>0.9</PsychicSensitivity>
                </statOffsets>
            </li>
            <li>
                <minSeverity>1</minSeverity>
                <label>chosen</label>
                <statOffsets>
                    <PsychicSensitivity>1</PsychicSensitivity>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>
</Defs>