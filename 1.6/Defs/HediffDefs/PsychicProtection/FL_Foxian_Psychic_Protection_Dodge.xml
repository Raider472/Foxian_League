<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <HediffDef ParentName="PsychiProtectionDodgeAbs">
        <defName>FL_PsychichProtectionDodge</defName>
        <label>Psychic dodge</label>
        <hediffClass>Foxian_league.HediffSeverityScalingStat</hediffClass>
        <minSeverity>0</minSeverity>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>0</initialSeverity>
        <stages>
            <li>
                <label>dormant</label>
            </li>
            <li>
                <!--All those values are the max when 100%-->
                <minSeverity>0.01</minSeverity>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
                <statOffsets>
                    <MeleeDodgeChance>20</MeleeDodgeChance>
                    <VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">0.5</VEF_RangedDodgeChance>
                    <StaggerDurationFactor>-0.25</StaggerDurationFactor>
                    <MoveSpeed>0.3</MoveSpeed>
                </statOffsets>
                <statFactors>
                    <PainShockThreshold>1.25</PainShockThreshold>
                    <IncomingDamageFactor>0.85</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <modExtensions>
            <li Class="Foxian_league.HediffExtension_ScalableSeverityStat">
                <scalingStat>PsychicSensitivity</scalingStat>
                <statLimit>1~3</statLimit>
            </li>
        </modExtensions>
    </HediffDef>
</Defs>