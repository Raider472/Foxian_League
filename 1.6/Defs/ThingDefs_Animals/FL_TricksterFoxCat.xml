<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="AnimalThingBase">
        <defName>FL_TricksterFoxCat</defName>
        <label>trickster cat</label>
        <devNote>FLCatFox</devNote>
        <description>A hybrid cat-fox-like creature commonly seen in foxian settlements, they are pretty much the equivalent of normal cats except for their innate talents at reading the future and bending the odds. Their nickname comes from the fact that they love being mischievous and their theorized association with the sacred beast related to trickery and knowledge. Despite their mischievousness, they can show affection to their owners if they are not busy trying to curse your colony with mild inconvenience.</description>
        <statBases>
            <MoveSpeed>4.8</MoveSpeed>
            <MarketValue>750</MarketValue>
            <ComfyTemperatureMin>-25</ComfyTemperatureMin>
            <Wildness>0</Wildness>
        </statBases>
        <race>
            <body>QuadrupedAnimalWithPawsAndTail</body>
            <predator>true</predator>
            <baseBodySize>0.3</baseBodySize>
            <maxPreyBodySize>0.25</maxPreyBodySize>
            <baseHungerRate>0.15</baseHungerRate>
            <baseHealthScale>0.42</baseHealthScale>
            <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
            <leatherDef>Leather_Light</leatherDef>
            <petness>1</petness>
            <trainability>Advanced</trainability>
            <specialTrainables>
                <li MayRequire="Ludeon.RimWorld.Odyssey">Comfort</li>
                <li MayRequire="Ludeon.RimWorld.Odyssey">Fl_FateManipulation</li>
            </specialTrainables>
            <nuzzleMtbHours>12</nuzzleMtbHours>
            <gestationPeriodDays>15</gestationPeriodDays>
            <nameOnTameChance>1</nameOnTameChance>
            <litterSizeCurve>
                <points>
                    <li>(0.5, 0)</li>
                    <li>(1, 1)</li>
                    <li>(2, 1.7)</li>
                    <li>(3, 0.7)</li>
                    <li>(3.5, 0)</li>
                </points>
            </litterSizeCurve>
            <lifeExpectancy>21</lifeExpectancy>
            <lifeStageAges>
                <li>
                    <def>AnimalBaby</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>AnimalJuvenile</def>
                    <minAge>0.15</minAge>
                </li>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0.4</minAge>
                    <soundWounded>Pawn_Cat_Injured</soundWounded>
                    <soundDeath>Pawn_Cat_Death</soundDeath>
                    <soundCall>Pawn_Cat_Call</soundCall>
                    <soundAngry>Pawn_Cat_Angry</soundAngry>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>PredatorSmall_Eat</soundEating>
            <headPosPerRotation>
                <li>(0.02, 0, 0.23)</li>
                <li>(0.35, 0, 0.05)</li>
                <li>(0.0, 0, -0.185)</li>
                <li>(-0.35, 0, 0.05)</li>
            </headPosPerRotation>
        </race>
        <tradeTags>
            <li>AnimalUncommon</li>
            <li>AnimalPet</li>
        </tradeTags>
        <tools>
            <li>
                <label>left claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.5</cooldownTime>
                <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>16</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>right claw</label>
                <labelNoLocation>claw</labelNoLocation>
                <capacities>
                    <li>Scratch</li>
                </capacities>
                <power>8</power>
                <cooldownTime>1.5</cooldownTime>
                <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>16</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>7</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.7</chanceFactor>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>14</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>3</power>
                <cooldownTime>2</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>
    </ThingDef>

