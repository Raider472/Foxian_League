<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="FoxianRaiderClothing">
        <defName>FL_BloodRainDeel</defName>
        <label>blood deel</label>
        <description>A traditional outfit from the blood rain reinforced with steel plates. It is used to convey their importance within the organization. Despite the outfit not being as protective compared to conventional armor, it is light to guarantee that the wearer can move without hindrance and embedded with blood rain runes to physically enhance the wearer. It is rumored that the empress gave these outfits to those who she trusts the most to carry out her more deranged orders.</description>
        <techLevel>Industrial</techLevel>
        <graphicData>
            <texPath>Things/Pawns/Apparels/OfficerArmor/OfficerArmor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <recipeMaker>
            <skillRequirements>
                <Crafting>8</Crafting>
            </skillRequirements>
        </recipeMaker>
        <costList>
            <Cloth>90</Cloth>
            <Gold>25</Gold>
            <Steel>35</Steel>
        </costList>
        <generateCommonality>2</generateCommonality>
        <statBases>
            <WorkToMake>17500</WorkToMake>
            <MaxHitPoints>280</MaxHitPoints>
            <Mass>2</Mass>
            <Flammability>0.8</Flammability>
            <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.18</ArmorRating_Blunt>
            <ArmorRating_Heat>0.5</ArmorRating_Heat>
            <Insulation_Cold>16</Insulation_Cold>
            <Insulation_Heat>8</Insulation_Heat>
            <EquipDelay>2.5</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <SocialImpact>0.2</SocialImpact>
            <SuppressionPower>0.25</SuppressionPower>
            <MoveSpeed>0.2</MoveSpeed>
            <MeleeDamageFactor>0.15</MeleeDamageFactor>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawns/Apparels/OfficerArmor/OfficerArmor</wornGraphicPath>
            <useWornGraphicMask>true</useWornGraphicMask>
            <layers>
                <li>Middle</li>
                <li>Shell</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
        <thingSetMakerTags>
            <li>RewardStandardMidFreq</li>
        </thingSetMakerTags>
    </ThingDef>

    <ThingDef ParentName="FoxianArmor">
