<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>FL_Blessing_Test</defName>
        <label>Blessing Test</label>
        <defaultLabelColor>(0.4, 0.4, 0.1)</defaultLabelColor>
        <description>Psychic energy emanates from the weapon of this person.</description>
        <hediffClass>Foxian_league.HediffSeverityScalingStat</hediffClass>
        <everCurableByItem>false</everCurableByItem>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
        <minSeverity>0</minSeverity>
        <maxSeverity>1</maxSeverity>
        <initialSeverity>0</initialSeverity>
        <stages>
            <li>
                <label>inactive</label>
            </li>
            <li>
                <minSeverity>0.01</minSeverity>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
                <statOffsets>
                    <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
                    <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
                    <ArmorRating_Heat>0.7</ArmorRating_Heat>
                    <StaggerDurationFactor>-0.5</StaggerDurationFactor>
                    <MoveSpeed>-0.22</MoveSpeed>
                    <Flammability>-0.5</Flammability>
                </statOffsets>
                <statFactors>
                    <PainShockThreshold>1.5</PainShockThreshold>
                    <IncomingDamageFactor>0.75</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_DisappearsOnDeath"/>
        </comps>
        <modExtensions>
            <li Class="Foxian_league.HediffExtension_ScalableSeverityStat">
                <scalingStat>PsychicSensitivity</scalingStat>
                <statLimit>1~3</statLimit>
            </li>
        </modExtensions>
    </HediffDef>
</Defs>