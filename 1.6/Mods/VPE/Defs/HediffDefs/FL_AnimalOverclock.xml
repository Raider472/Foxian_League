        <defName>FL_AnimalOverclock</defName>
        <label>animal overclock</label>
        <description>This animal has been temporarily psychically altered by a psycaster. Their instincts, speed, and strength have been enhanced. Their bleeding wounds will also close instantaneously.</description>
        <hediffClass>Foxian_league.Hediff_Clotting</hediffClass>
        <stages>
            <li>
                <statOffsets>
                    <MeleeDamageFactor>0.25</MeleeDamageFactor>
                    <VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">0.2</VEF_RangedDodgeChance>
                    <StaggerDurationFactor>-0.2</StaggerDurationFactor>
                </statOffsets>
                <statFactors>
                    <MoveSpeed>1.5</MoveSpeed>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
</Defs>