<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef ParentName="CurseAbs">
        <defName>FL_CurseSubmission</defName>
        <label>curse of compliance</label>
        <description>This person has been cursed by one of the Foxian sacred beasts, representing the aspect of subjugation and domination. They constantly fight the urge to give up their struggle for survival and submit to their enemies. While this effect is active, they will be less effective in combat and more susceptible to foreign
                ideologies.</description>
        <makesSickThought>true</makesSickThought>
        <stages>
            <li>
                <statOffsets>
                    <AimingDelayFactor>0.4</AimingDelayFactor>
                    <RangedCooldownFactor>0.5</RangedCooldownFactor>
                    <SocialImpact>-0.5</SocialImpact>
                </statOffsets>
                <statFactors>
                    <MeleeDamageFactor>0.5</MeleeDamageFactor>
                    <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">1.75</CertaintyLossFactor>
                    <ConversionPower MayRequire="Ludeon.RimWorld.Ideology">0.5</ConversionPower>
                    <StaggerDurationFactor>1.5</StaggerDurationFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
</Defs>