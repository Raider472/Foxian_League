    <VEF.Abilities.AbilityDef ParentName="VPE_PsycastBase">
        <defName>FL_VPE_AnimalOverclock</defName>
        <label>animal overclock</label>
        <description>Drugs the animals to overclock them. time scale with psysens</description>
        <iconPath>UI/Psycast/Ability/FL_AnimalOverclock</iconPath>
        <abilityClass>VEF.Abilities.Ability_Blank</abilityClass>
        <targetMode>Self</targetMode>
        <castTime>15</castTime>
        <durationTime>2000</durationTime>
        <castSound>VPE_ShieldAnimals_Cast</castSound>
        <radius>10</radius>
        <hasAoE>true</hasAoE>
        <cooldownTime>25000</cooldownTime>
        <durationTimeStatFactors>
            <PsychicSensitivity>1.5</PsychicSensitivity>
        </durationTimeStatFactors>
        <targetingParametersForAoE>
            <canTargetPawns>true</canTargetPawns>
            <canTargetAnimals>true</canTargetAnimals>
            <canTargetHumans>false</canTargetHumans>
            <canTargetMechs>false</canTargetMechs>
            <canTargetBuildings>false</canTargetBuildings>
            <mustBeSameFaction>true</mustBeSameFaction>
            <ignoreRangeAndSight>true</ignoreRangeAndSight>
        </targetingParametersForAoE>
        <modExtensions>
            <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
                <path>FL_VPE_Naturastodis</path>
                <level>2</level>
                <order>2</order>
                <psyfocusCost>0.2</psyfocusCost>
                <entropyGain>36</entropyGain>
                <prerequisites>
                    <li>FL_VPE_NaturaBloom</li>
                </prerequisites>
            </li>
            <li Class="VEF.Abilities.AbilityExtension_Hediff">
                <hediff>FL_AnimalOverclock</hediff>
            </li>
        </modExtensions>
    </VEF.Abilities.AbilityDef>

