<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="TreeBase">
        <defName>FL_Plant_SacrificialTree</defName>
        <label>sacrificial tree</label>
        <description>An artificial, morbid tree with a humanoid silhouette visible on its bark. Its name comes from its association with the sacrificial ritual that Naturastodis psycasters perform in the hope of receiving blessings from their gods. Most people do not know why this tree has this specific humanoid form, because the Naturastodis psycasters keep this information secret. However, many non-psycaster Foxians firmly believe that a human body was used to make this tree.</description>
        <graphicData>
            <texPath>Things/Plants/Sacrificial</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <shadowData>
            <volume>(0.35, 0.3, 0.35)</volume>
            <offset>(0,0,0.05)</offset>
            </shadowData>
        </graphicData>
        <minifiedDef IsNull="True" />
        <statBases>
            <Beauty>10</Beauty>
            <BeautyOutdoors>10</BeautyOutdoors>
            <Flammability>1</Flammability>
            <MaxHitPoints>300</MaxHitPoints>
        </statBases>
        <ingestible />
        <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
        <canScatterOver>false</canScatterOver>
        <plant>
            <growDays>1</growDays>
            <visualSizeRange>1.8~2.5</visualSizeRange>
            <sowMinSkill>0</sowMinSkill>
            <sowTags Inherit="False"/>
            <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
            <fertilityMin>0.1</fertilityMin>
            <fertilitySensitivity>0</fertilitySensitivity>
            <wildClusterWeight>0</wildClusterWeight>
            <treeCategory>Super</treeCategory>
            <dieIfNoSunlight>false</dieIfNoSunlight>
            <sowResearchPrerequisites Inherit="False" />
            <dieFromToxicFallout>False</dieFromToxicFallout>
            <minSpacingBetweenSamePlant>0</minSpacingBetweenSamePlant>
            <warnIfMarkedForCut>true</warnIfMarkedForCut>
            <choppedThingDef>FL_ChoppedStump_SacrificialTree</choppedThingDef>
            <smashedThingDef>FL_SmashedStump_SacrificialTree</smashedThingDef>
            <snowOverlayGraphicPath>Things/Plants/Sacrificial_Snowy</snowOverlayGraphicPath>
        </plant>
        <comps>
            <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                    <li>Natural</li>
                </focusTypes>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="StumpChoppedBase">
        <defName>FL_ChoppedStump_SacrificialTree</defName>
        <label>chopped sacrificial tree stump</label>
        <description>A stump left behind after a sacrificial tree has been felled. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Chopped/FL_SacrificialTree_CutStump</texPath>
            <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    </ThingDef>

    <ThingDef ParentName="StumpSmashedBase">
        <defName>FL_SmashedStump_SacrificialTree</defName>
        <label>smashed sacrificial tree stump</label>
        <description>The remnants of a sacrificial tree destroyed by damage. It's ugly. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Smashed/FL_SacrificialTree_SmashedStump</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>
</Defs>