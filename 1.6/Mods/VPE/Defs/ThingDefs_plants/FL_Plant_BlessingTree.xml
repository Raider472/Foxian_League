<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="TreeBase">
        <defName>FL_Plant_BlessingTree</defName>
        <label>Jubokko</label>
        <description>Desc.</description>
        <graphicData>
            <texPath>Things/Plants/Natura</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <shadowData>
            <volume>(0.35, 0.3, 0.35)</volume>
            <offset>(0,0,0.05)</offset>
            </shadowData>
        </graphicData>
        <minifiedDef IsNull="True" />
        <statBases>
            <Beauty>10</Beauty>
            <BeautyOutdoors>10</BeautyOutdoors>
            <Flammability>1</Flammability>
            <MaxHitPoints>300</MaxHitPoints>
        </statBases>
        <ingestible />
        <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
        <canScatterOver>false</canScatterOver>
        <plant>
            <growDays>1</growDays>
            <visualSizeRange>1.8~2.5</visualSizeRange>
            <sowMinSkill>0</sowMinSkill>
            <sowTags Inherit="False"/>
            <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
            <fertilityMin>0.1</fertilityMin>
            <fertilitySensitivity>0</fertilitySensitivity>
            <wildClusterWeight>0</wildClusterWeight>
            <treeCategory>Super</treeCategory>
            <dieIfNoSunlight>false</dieIfNoSunlight>
            <sowResearchPrerequisites Inherit="False" />
            <dieFromToxicFallout>False</dieFromToxicFallout>
            <minSpacingBetweenSamePlant>0</minSpacingBetweenSamePlant>
            <warnIfMarkedForCut>true</warnIfMarkedForCut>
            <choppedThingDef>FL_ChoppedStump_BlessingTree</choppedThingDef>
            <smashedThingDef>FL_SmashedStump_BlessingTree</smashedThingDef>
            <immatureGraphicPath>Things/Plants/Natura</immatureGraphicPath>
            <snowOverlayGraphicPath>Things/Plants/Natura_Snowy</snowOverlayGraphicPath>
            <immatureSnowOverlayGraphicPath>Things/Plants/Natura_Snowy</immatureSnowOverlayGraphicPath>
        </plant>
        <comps>
            <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                    <li>Natural</li>
                </focusTypes>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="StumpChoppedBase">
        <defName>FL_ChoppedStump_BlessingTree</defName>
        <label>chopped HumanoidTreeSomething stump</label>
        <description>A stump left behind after a HumanoidTreeSomething tree has been felled. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Chopped/FL_NaturaChopped</texPath>
            <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    </ThingDef>

    <ThingDef ParentName="StumpSmashedBase">
        <defName>FL_SmashedStump_BlessingTree</defName>
        <label>smashed HumanoidTreeSomething stump</label>
        <description>The remnants of a HumanoidTreeSomething tree destroyed by damage. It's ugly. The stump can be extracted but yields very little usable wood. Left outdoors, the stump will deteriorate in time.</description>
        <graphicData>
            <texPath>Things/Plants/Stumps/Smashed/FL_NaturaSmashed</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>
</Defs>