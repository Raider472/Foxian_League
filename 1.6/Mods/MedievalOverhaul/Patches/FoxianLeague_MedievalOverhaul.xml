                                    <FL_Foxian_League_Hunter_Medieval>4</FL_Foxian_League_Hunter_Medieval>
                                    <FL_Foxian_Veteran_Medieval>5</FL_Foxian_Veteran_Medieval>
                                    <FL_Foxian_Officer_Medieval>3</FL_Foxian_Officer_Medieval>
                                    <FL_Foxian_Royal_Melee_Infantry_Medieval>8</FL_Foxian_Royal_Melee_Infantry_Medieval>
                                    <FL_Foxian_Oracle_Medieval>3</FL_Foxian_Oracle_Medieval>
                                </options>
                            </li>
                            <li>
                                <kindDef>Peaceful</kindDef>
                                <options>
                                    <FL_Foxian_Villager_Medieval>20</FL_Foxian_Villager_Medieval>
                                    <FL_Foxian_Villager_Child MayRequire="Ludeon.RimWorld.Biotech">2</FL_Foxian_Villager_Child>
                                    <FL_Foxian_Town_Guard_Medieval>10</FL_Foxian_Town_Guard_Medieval>
                                    <FL_Foxian_Politician_Medieval>10</FL_Foxian_Politician_Medieval>
                                    <FL_Foxian_Noble_Medieval>2</FL_Foxian_Noble_Medieval>
                                    <FL_Foxian_Diplomat_Medieval>4</FL_Foxian_Diplomat_Medieval>
                                </options>
                            </li>
                            <li>
                                <kindDef>Trader</kindDef>
                                <traders>
                                    <FL_Foxian_Trader_Medieval>1</FL_Foxian_Trader_Medieval>
                                </traders>
                                <carriers>
                                    <FL_Vulpano>8</FL_Vulpano>
                                    <Muffalo>2</Muffalo>
                                    <Dromedary>1</Dromedary>
                                    <Alpaca>1</Alpaca>
                                    <Elephant>1</Elephant>
                                </carriers>
                                <guards>
                                    <FL_Foxian_Diplomat_Medieval>2</FL_Foxian_Diplomat_Medieval>
                                    <FL_Foxian_Noble_Medieval>2</FL_Foxian_Noble_Medieval>
                                    <FL_Foxian_Villager_Medieval>3</FL_Foxian_Villager_Medieval>
                                    <FL_Foxian_Town_Guard_Medieval>10</FL_Foxian_Town_Guard_Medieval>
                                    <FL_Foxian_League_Grenadier_Flame_Medieval>1.5</FL_Foxian_League_Grenadier_Flame_Medieval>
                                    <FL_Foxian_League_Infantryman_Medieval>10</FL_Foxian_League_Infantryman_Medieval>
                                    <FL_Foxian_League_Archer_Medieval>10</FL_Foxian_League_Archer_Medieval>
                                    <FL_Foxian_League_Hunter_Medieval>6</FL_Foxian_League_Hunter_Medieval>
                                    <FL_Foxian_Officer_Medieval>3</FL_Foxian_Officer_Medieval>
                                    <FL_Foxian_Man_At_Arms_Medieval>5</FL_Foxian_Man_At_Arms_Medieval>
                                    <FL_Foxian_Veteran_Medieval>4</FL_Foxian_Veteran_Medieval>
                                    <FL_Foxian_Royal_Melee_Infantry_Medieval>8</FL_Foxian_Royal_Melee_Infantry_Medieval>
                                </guards>
                            </li>
                            <li>
                                <kindDef>Settlement</kindDef>
                                <options>
                                    <FL_Foxian_Villager_Medieval>10</FL_Foxian_Villager_Medieval>
                                    <FL_Foxian_Diplomat_Medieval>4</FL_Foxian_Diplomat_Medieval>
                                    <FL_Foxian_Villager_Child MayRequire="Ludeon.RimWorld.Biotech">2</FL_Foxian_Villager_Child>
                                    <FL_Foxian_Noble_Medieval>4</FL_Foxian_Noble_Medieval>
                                    <FL_Foxian_Politician_Medieval>8</FL_Foxian_Politician_Medieval>
                                    <FL_Foxian_Town_Guard_Medieval>10</FL_Foxian_Town_Guard_Medieval>
                                    <FL_Foxian_League_Grenadier_Flame_Medieval>2</FL_Foxian_League_Grenadier_Flame_Medieval>
                                    <FL_Foxian_League_Infantryman_Medieval>10</FL_Foxian_League_Infantryman_Medieval>
                                    <FL_Foxian_League_Scout_Medieval>5</FL_Foxian_League_Scout_Medieval>
                                    <FL_Foxian_League_Archer_Medieval>7</FL_Foxian_League_Archer_Medieval>
                                    <FL_Foxian_League_Hunter_Medieval>8</FL_Foxian_League_Hunter_Medieval>
                                    <FL_Foxian_Veteran_Medieval>6</FL_Foxian_Veteran_Medieval>
                                    <FL_Foxian_Officer_Medieval>3</FL_Foxian_Officer_Medieval>
                                    <FL_Foxian_Royal_Melee_Infantry_Medieval>8</FL_Foxian_Royal_Melee_Infantry_Medieval>
                                    <FL_Vulpano>0.5</FL_Vulpano>
                                </options>
                            </li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">
                                <kindDef>Miners</kindDef>
                                <commonality>1</commonality>
                                <options>
                                    <Miner>1</Miner>
                                </options>
                            </li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">
                                <kindDef>Hunters</kindDef>
                                <commonality>1</commonality>
                                <options>
                                    <Hunter>1</Hunter>
                                </options>
                            </li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">
                                <kindDef>Loggers</kindDef>
                                <commonality>1</commonality>
                                <options>
                                    <Logger>1</Logger>
                                </options>
                            </li>
                            <li MayRequire="Ludeon.RimWorld.Ideology">
                                <kindDef>Farmers</kindDef>
                                <commonality>1</commonality>
                                <options>
                                    <Farmer>1</Farmer>
                                </options>
                            </li>
                        </pawnGroupMakers>
                    </value>
                </li>
                <!--Replace
                Fixed Leader Kind-->
                <li Class="PatchOperationReplace">
                    <xpath>
                        Defs/FactionDef[defName="Foxian_League"]/fixedLeaderKinds</xpath>
                    <value>
                        <fixedLeaderKinds>
                            <li>FL_Foxian_League_counselor_Medieval</li>
                        </fixedLeaderKinds>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>